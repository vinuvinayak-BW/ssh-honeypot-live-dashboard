# Copy this file to .env.proxy and set the real DNS name and email.
DOMAIN=dashboard.example.com
LE_EMAIL=you@example.com

# Choose exactly one: basic or oauth2. Basic Auth is the default.
AUTH_MODE=basic

# OAuth2 Proxy settings are only used with AUTH_MODE=oauth2.
# Register https://YOUR_DOMAIN/oauth2/callback with your OIDC provider.
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://identity.example.com
OAUTH2_PROXY_CLIENT_ID=replace-me
OAUTH2_PROXY_CLIENT_SECRET=replace-me
OAUTH2_PROXY_COOKIE_SECRET=replace-with-32-byte-url-safe-base64-secret
OAUTH2_PROXY_EMAIL_DOMAINS=example.com
OAUTH2_PROXY_SCOPE=openid email profile
