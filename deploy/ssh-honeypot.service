[Unit]
Description=SSH honeypot on port 2222 (all logins rejected)
After=network.target

[Service]
Type=simple
User=honeypot
Group=honeypot
WorkingDirectory=/opt/ssh-honeypot
Environment=HONEYPOT_LOG_DIR=/var/log/ssh-honeypot
Environment=HONEYPOT_STATE_DIR=/etc/ssh-honeypot
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ssh-honeypot/.venv/bin/python /opt/ssh-honeypot/honeypot.py
Restart=on-failure
RestartSec=3

# ---------------------------------------------------------------------------
# Sandbox.  The process cannot see /home, cannot write anywhere except its log
# directory, has no capabilities, and cannot create new namespaces or load
# kernel modules.  It still owns exactly one listening socket: TCP/2222.
# ---------------------------------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/log/ssh-honeypot
ReadOnlyPaths=/opt/ssh-honeypot /etc/ssh-honeypot
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
LimitNOFILE=4096
TasksMax=256

[Install]
WantedBy=multi-user.target
